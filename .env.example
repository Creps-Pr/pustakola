APP_NAME=Pustakaloka
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://perpustakaan.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=single
LOG_LEVEL=debug

# Basis data (Laragon: MySQL, user root tanpa kata sandi)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=perpustakaan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
FILESYSTEM_DISK=public

# Aturan perpustakaan
PERPUSTAKAAN_NAMA=Pustakaloka
PERPUSTAKAAN_TAGLINE="Perpustakaan Digital Modern"
PERPUSTAKAAN_LAMA_PINJAM=7
PERPUSTAKAAN_DENDA_PER_HARI=1000
PERPUSTAKAAN_MAKS_PINJAM=3
PERPUSTAKAAN_MAKS_PERPANJANG=2
PERPUSTAKAAN_LAMA_PERPANJANG=7
